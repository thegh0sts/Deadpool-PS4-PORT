<!-- Deadpool (EU, CUSA03528 01.00). shadPS4/GoldHEN patch format (scripts/patches.py). -->
<Patch>
  <TitleID>
    <ID>CUSA03528</ID>
  </TitleID>
  <!-- Unreal Engine 3's FEngineLoop::Tick sleeps until 1 / GetMaxTickRate() has passed since the
       last frame; Deadpool's engine settings return 30 (smoothed frame rate). The jump skips that
       wait, so the frame rate is limited only by the port (its FPS limit setting). run.py and
       run.sh turn it on with BB_FPS=uncap, which also ignores the game's flip rate (a flip
       every 2nd vblank). Game logic uses the measured frame time. -->
  <Metadata Title="Deadpool" Name="Unlock frame rate"
            Note="Removes the engine's 30 FPS frame limiter (use with BB_FPS=uncap)."
            Author="deadpool-ps4-port" PatchVer="1.0" AppVer="01.00" AppElf="eboot.bin"
            isEnabled="false">
    <PatchList>
      <!-- jbe <skip the wait> after "if (MaxTickRate > 0)" becomes jmp. -->
      <Line Type="bytes" Address="0x00b8848e" Value="e9f500000090"
            Signature="ff 90 a8 02 00 00 c5 f0 57 c9 c5 f8 2e c1 0f 86 f4 00 00 00"
            SignatureOffset="14"/>
    </PatchList>
  </Metadata>
</Patch>
